{
  "name": "@felix-ayush/openhearth-core",
  "version": "2.7.0",
  "private": true,
  "description": "Internal audit engine — bundled into @felix-ayush/openhearth (not published).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ayush Kumar",
    "url": "https://github.com/Ayush7614"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayush7614/OpenHearth.git",
    "directory": "packages/core"
  },
  "homepage": "https://ayush7614.github.io/OpenHearth/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gist.js": {
      "types": "./dist/gist.d.ts",
      "import": "./dist/gist.js"
    },
    "./github.js": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js"
    },
    "./aggregate.js": {
      "types": "./dist/aggregate.d.ts",
      "import": "./dist/aggregate.js"
    },
    "./llm.js": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    },
    "./insights.js": {
      "types": "./dist/insights.d.ts",
      "import": "./dist/insights.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "github",
    "contributions",
    "audit",
    "search-api",
    "openhearth"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
