  "description": "CLI to audit every GitHub PR, issue, and review — find repos hidden from your activity feed (\"N repositories not shown\")",
  "type": "module",
  "bin": {
    "openhearth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
