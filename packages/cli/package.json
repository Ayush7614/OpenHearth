    "build": "node build.mjs",
    "dev": "node build.mjs && node dist/cli.js",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "github-contributions",
    "contributions",
    "pull-requests",
    "issues",
    "code-review",
    "open-source",
    "oss",
    "audit",
    "cli",
    "developer-tools",
    "activity-feed",
    "contribution-graph",
    "search-api",
    "openhearth"
  ],
  "license": "MIT",
  "author": {
    "name": "Ayush Kumar",
    "url": "https://github.com/Ayush7614"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayush7614/OpenHearth.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ayush7614.github.io/OpenHearth/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Ayush7614/OpenHearth/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@felix-ayush/openhearth-core": "*",
